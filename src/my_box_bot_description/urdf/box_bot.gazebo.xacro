<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
<xacro:macro name="gazebo_elements" params="robot_name">

  <gazebo reference="left_wheel">
    <collision>
        <surface>
        <friction>
            <ode>
            <mu>10.0</mu>
            <mu2>10.0</mu2>
            </ode>
        </friction>
        <contact>
            <ode>
            <kp>10000000.0</kp>
            <kd>10000000.0</kd>
            </ode>
        </contact>
        </surface>
    </collision>
    <visual>
        <material>
            <!-- Red -->
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
        </material>
    </visual>
  </gazebo>

  <gazebo reference="right_wheel">
    <collision>
        <surface>
        <friction>
            <ode>
            <mu>10.0</mu>
            <mu2>10.0</mu2>
            </ode>
        </friction>
        <contact>
            <ode>
            <kp>10000000.0</kp>
            <kd>10000000.0</kd>
            </ode>
        </contact>
        </surface>
    </collision>
    <visual>
        <material>
            <!-- Green -->
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
        </material>
    </visual>
  </gazebo>

  <gazebo reference="front_pitch_link">
    <collision>
        <surface>
        <friction>
            <ode>
            <mu>0.5</mu>
            <mu2>0.5</mu2>
            </ode>
        </friction>
        <contact>
            <ode>
            <kp>10000000.0</kp>
            <kd>10000000.0</kd>
            </ode>
        </contact>
        </surface>
    </collision>
    <visual>
        <material>
            <!-- Purple -->
            <ambient>1 0 1 1</ambient>
            <diffuse>1 0 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
        </material>
    </visual>
  </gazebo>

  <gazebo reference="back_pitch_link">
    <collision>
        <surface>
        <friction>
            <ode>
            <mu>0.5</mu>
            <mu2>0.5</mu2>
            </ode>
        </friction>
        <contact>
            <ode>
            <kp>10000000.0</kp>
            <kd>10000000.0</kd>
            </ode>
        </contact>
        </surface>
    </collision>
    <visual>
        <material>
            <!-- Yellow -->
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
        </material>
    </visual>
  </gazebo>

  <gazebo reference="front_yaw_link">
    <visual>
        <material>
            <!-- Blue -->
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
        </material>
    </visual>
  </gazebo>

  <gazebo reference="front_roll_link">
    <visual>
        <material>
            <!-- Red -->
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
        </material>
    </visual>
  </gazebo>

  <gazebo reference="back_yaw_link">
    <visual>
        <material>
            <!-- Blue -->
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
        </material>
    </visual>
  </gazebo>

  <gazebo reference="back_roll_link">
    <visual>
        <material>
            <!-- Red -->
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
        </material>
    </visual>
  </gazebo>

  <!-- PLUGINS -->

  <!-- Joint State Publisher Plugin -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
        <topic>${robot_name}/joint_states</topic>
        <update_rate>30</update_rate>
        <!-- Publish the state of these joints -->
        <joint_name>joint_left_wheel</joint_name>
        <joint_name>joint_right_wheel</joint_name>
        <joint_name>front_yaw_joint</joint_name>
        <joint_name>back_yaw_joint</joint_name>
        <joint_name>front_roll_joint</joint_name>
        <joint_name>back_roll_joint</joint_name>
        <joint_name>front_pitch_joint</joint_name>
        <joint_name>back_pitch_joint</joint_name>
    </plugin>
  </gazebo>  

  <!-- Differential Drive Plugin -->
  <gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>joint_left_wheel</left_joint>
        <right_joint>joint_right_wheel</right_joint>
        <wheel_separation>0.1</wheel_separation>
        <wheel_radius>0.035</wheel_radius>
        <topic>${robot_name}/cmd_vel</topic>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>
        <odom_topic>${robot_name}/odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>${robot_name}/odom</frame_id>
        <child_frame_id>${robot_name}/base_link</child_frame_id>
    </plugin>
  </gazebo>

</xacro:macro>     
</robot>